    {
      "parameters": {
        "jsCode": "// Obtenemos el JSON que llega del Webhook\nconst inputJson = $input.first().json;\n\n// n8n suele guardar el cuerpo del POST en inputJson.body, o a veces directo en inputJson\nconst payload = inputJson.body || inputJson;\n\n// Buscamos el array de transacciones donde sea que esté\nlet transactions = [];\n\nif (payload.transactions && Array.isArray(payload.transactions)) {\n  transactions = payload.transactions;\n} else {\n  // Búsqueda automática de cualquier array dentro del payload\n  const foundKey = Object.keys(payload).find(key => Array.isArray(payload[key]));\n  if (foundKey) {\n    transactions = payload[foundKey];\n  }\n}\n\n// Si encontramos las transacciones, devolvemos cada una como un ítem independiente\nif (transactions.length > 0) {\n  return transactions.map(tx => ({ json: tx }));\n} else {\n  // Si no se encuentra, devolvemos un registro indicando qué llegó para depurar\n  return [{ json: { error: \"No se encontró el array transactions\", received_keys: Object.keys(payload) } }];\n}"
      },
